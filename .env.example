# Copy to .env before running: docker compose up -d

# PostgreSQL
POSTGRES_USER=unitseek_mdm
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_DB=unitseek_mdm
DATABASE_URL=postgresql+asyncpg://unitseek_mdm:change-this-local-password@db:5432/unitseek_mdm

# Application
DEBUG=true
DEPLOYMENT_MODE=selfhosted
SECRET_KEY=replace-with-at-least-32-random-characters
CORS_ORIGINS=["http://localhost:5173"]
# Keep false only for this local HTTP example. Production HTTPS must use true.
SESSION_COOKIE_SECURE=false
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=900

# AMAPI: keep mock until Google project, credentials, and quota are ready.
AMAPI_MODE=mock
GCP_PROJECT_ID=
GCP_CREDENTIALS_PATH=/run/secrets/gcp-service-account.json
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=15
ENABLE_DOCS=true

# Keep blank when nginx serves both the UI and /api on this same origin.
VITE_API_URL=
