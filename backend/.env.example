# =============================================================================
# Unitseek MDM - Backend Configuration
# =============================================================================
# Copy this file to .env and fill in your values.

# -- Application --
APP_NAME=Unitseek MDM
DEBUG=false
DEPLOYMENT_MODE=selfhosted

# -- Database (PostgreSQL + asyncpg for local development) --
DATABASE_URL=postgresql+asyncpg://unitseek_mdm:replace-with-a-local-password@localhost:5433/unitseek_mdm

# -- JWT Authentication --
SECRET_KEY=replace-with-at-least-32-random-characters
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
SESSION_COOKIE_SECURE=true
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=900

# -- Google Cloud Platform --
AMAPI_MODE=mock
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=15
GCP_PROJECT_ID=your-project-id
GCP_CREDENTIALS_PATH=credentials/gcp-service-account.json

# -- CORS (JSON array of allowed origins) --
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]

# -- API Documentation --
ENABLE_DOCS=true
