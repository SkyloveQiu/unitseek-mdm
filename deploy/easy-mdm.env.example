# Copy to /etc/easy-mdm/easy-mdm.env on the VM and replace every placeholder.
# URL-encode reserved characters in the database password.
DATABASE_URL=mysql+aiomysql://easy_mdm:replace-with-url-encoded-password@your-mysql-server.mysql.database.azure.com:3306/unitseek_mdm?charset=utf8mb4
DATABASE_SSL_CA=/etc/easy-mdm/DigiCertGlobalRootG2.crt.pem
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5

DEBUG=false
DEPLOYMENT_MODE=selfhosted
SECRET_KEY=replace-with-at-least-32-random-characters
SESSION_COOKIE_SECURE=true
CORS_ORIGINS=["https://mdm.example.com"]
AUTH_LOGIN_MAX_ATTEMPTS=10
AUTH_LOGIN_WINDOW_SECONDS=900
ENABLE_DOCS=false

AMAPI_MODE=mock
GCP_PROJECT_ID=
GCP_CREDENTIALS_PATH=/etc/easy-mdm/gcp-service-account.json
SYNC_ENABLED=true
SYNC_INTERVAL_MINUTES=15
